<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Parallelization is disabled in AssemblyInfo.cs; the MSBuild property of that name does nothing. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EasyReasy.Database.Testing\EasyReasy.Database.Testing.csproj" />
    <ProjectReference Include="..\EasyReasy.Database.Testing.Npgsql\EasyReasy.Database.Testing.Npgsql.csproj" />
    <ProjectReference Include="..\EasyReasy.Database.Testing.PruneTool\EasyReasy.Database.Testing.PruneTool.csproj" />
  </ItemGroup>

</Project>
